 /* static */
 bool nsHTTPSOnlyUtils::OnionException(nsIURI* aURI) {
+  nsAutoCString host;
+  aURI->GetHost(host);
+  // Nullpath: .i2p sites are encrypted end to end by I2P and rarely offer
+  // HTTPS, so don't upgrade them while they count as secure contexts.
+  if (mozilla::StaticPrefs::dom_securecontext_allowlist_i2p() &&
+      StringEndsWith(host, ".i2p"_ns)) {
+    return true;
+  }
   // Onion-host exception can get disabled with a pref
   if (mozilla::StaticPrefs::dom_security_https_only_mode_upgrade_onion()) {
     return false;
   }
-  nsAutoCString host;
-  aURI->GetHost(host);
   return StringEndsWith(host, ".onion"_ns);
 }
 
